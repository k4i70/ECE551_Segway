# Read in files
read_file -format sverilog {PID.sv balance_cntrl.sv SegwayMath.sv}
set current_design balance_cntrl
link

# Create clk Signal
create_clock -name "clk" -period 8 { clk }
set_dont_touch_network {clk}

# Prim Inputs and Input Delay
set prim_inputs [remove_from_collection [all_inputs] [find port clk]]
set_input_delay -clock clk .3 [copy_collection $prim_inputs]

# Set Drive Inputs
set drive_inputs [remove_from_collection [copy_collection $prim_inputs] [find port rst_n]]
set_driving_cell -lib_cell NAND2X2_RVT $drive_inputs


set_output_delay -clock clk 0.75 [all_outputs]


set_load 0.05 [all_outputs]

set_max_transition 0.15 [current_design]

set_wire_load_model -name 16000


compile -map_effort medium
ungroup -all -flatten
compile -map_effort medium

report_timing -path full -delay min
report_timing -path full -delay max

report_area > area.txt
ungroup -all -flatten

write -format verilog balance_cntrl -output balance_cntrl.vg
