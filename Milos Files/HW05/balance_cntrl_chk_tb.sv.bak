`timescale 1ns/1ps
module balance_cntrl_chk_tb;
/*
Exercise 17 balance_cntrl_chk_tb.v Hints:
• Instantiate DUT (balance_cntrl.sv) (name the instance iDUT) connecting
all the inputs to the respective bits of a 49-bit wide vector of type reg.
• Declare a “memory” of type reg that is 49-bits wide and has 1500
entries. This is your stimulus memory
• Declare a “memory” of type reg that is 25-bits wide and has 1500
entries. This is your expected response memory
• Inside the main “initial” block of your testbench do a $readmemh of the
provided .hex files into the respective “memories”
• Ensure you have a: force iDUT.ss_tmr = 8’hFF; in the initial block
• Start clk at zero and toggle it every #5 time units the way we often do
• In a for loop going over 1500 entries assign an entry of the stim memory
to the stim vector that drives the DUT inputs
• Wait for @(posedge clk), then wait for #1 more time unit. Now check,
do DUT outputs match the respective bits of the response vector?
*/

    // DUT input vector: 49 bits
    reg [48:0] stim_vector;
    // Stimulus memory: 1500 entries of 49 bits
    reg [48:0] stim_memory [0:1499];
    // Expected response memory: 1500 entries of 25 bits
    reg [24:0] resp_memory [0:1499];

    logic clk;
    logic pass;

    // DUT outputs
    wire [11:0] lft_spd;
    wire [11:0] rgt_spd;
    wire too_fast;

    // Instantiate the DUT
    balance_cntrl iDUT (
        .ptch(stim_vector[46:31]),
        .ptch_rt(stim_vector[30:15]),
        .vld(stim_vector[47]),
        .clk(clk),
        .rst_n(stim_vector[48]),
        .pwr_up(stim_vector[14]),
        .rider_off(stim_vector[13]),
        .steer_pot(stim_vector[12:1]),
        .en_steer(stim_vector[0]),
        .lft_spd(lft_spd),
        .rgt_spd(rgt_spd),
        .too_fast(too_fast)
    );

    // Clock generation
    initial begin
        clk = 0; // clk starts at 0
        forever #5 clk = ~clk; // toggle clk every #5 time units
    end

    initial begin
        // Read stimulus and response memories from hex files
        $readmemh("balance_cntrl_stim.hex", stim_memory);
        $readmemh("balance_cntrl_resp.hex", resp_memory);

        // Force ss_tmr to 8'hFF

        pass   = 1'b1;
        
        // Apply stimuli and check responses
        for (int i = 0; i < 1500; i++) begin
            stim_vector = stim_memory[i]; // Apply stimulus

            @(posedge clk); // Wait for posedge clk
            #1; // Wait for #1 time unit

            // Check outputs against expected response
            if ({lft_spd, rgt_spd, too_fast} !== resp_memory[i]) begin
                $display("Mismatch at entry %0d: Expected %h, Got %h", i, resp_memory[i], {lft_spd, rgt_spd, too_fast});
                pass = 1'b0;
            end 
        end
        if (pass)
            $display("All tests passed!");
        else
            $display("Some tests failed.");

        $stop;
    end
endmodule