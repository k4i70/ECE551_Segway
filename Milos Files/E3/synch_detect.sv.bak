module synch_detect (
    input  logic clk,
    input  logic rst_n,
    input  logic asynch_sig_in,
    output logic rise_edge
);

    // Two-stage synchronizer
    logic sync_stage1, sync_stage2, synch_stage3;

    dff first_stage (
        .clk(clk),
        .PRN(rst_n),
        .D(asynch_sig_in),
        .Q(sync_stage1)
    );
    dff second_stage (
        .clk(clk),
        .PRN(rst_n),
        .D(sync_stage1),
        .Q(sync_stage2)
    );
    // Edge detection
    dff edge_detect (
        .clk(clk),
        .PRN(rst_n),
        .D(sync_stage2),
        .Q(synch_stage3)
    );
    
    //assign rise_edge = sync_stage2 & ~synch_stage3; but in structural verilog
    logic not_synch_stage3;
    NOT u_not (not_synch_stage3, synch_stage3);
    AND u_and (rise_edge, sync_stage2, not_synch_stage3);
endmodule